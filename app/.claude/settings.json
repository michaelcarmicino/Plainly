{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Write(../presentation/evidence/**)",
      "Edit(../presentation/evidence/**)",
      "Write(../presentation/screenshots/**)",
      "Read(../agents/**)",
      "Read(../CLAUDE.md)"
    ],
    "deny": [
      "Write(../agents/**)",
      "Write(../.claude/**)",
      "Edit(../agents/**)",
      "Edit(../.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/hooks/contratti-congelati.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/hooks/guardrail-dopo-modifica.mjs",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "node ../.claude/hooks/tipi-dopo-modifica.mjs",
            "timeout": 70
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/hooks/benvenuto-developer.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
