{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(node scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(tests/**)",
      "Write(tests/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(fixtures/**)",
      "Write(../presentation/evidence/**)",
      "Edit(../presentation/evidence/**)",
      "Write(../presentation/screenshots/**)",
      "Read(../agents/**)",
      "Read(../CLAUDE.md)"
    ],
    "deny": [
      "Write(../agents/**)",
      "Edit(../agents/**)",
      "Write(../.claude/**)",
      "Edit(../.claude/**)",
      "Write(types/**)",
      "Edit(types/**)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/hooks/contratti-congelati.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/hooks/guardrail-dopo-modifica.mjs",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "node ../.claude/hooks/tipi-dopo-modifica.mjs",
            "timeout": 70
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../.claude/hooks/benvenuto-developer.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
