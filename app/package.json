{
  "name": "plainly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plainly — educazione alla finanza personale di base. Gira offline: nessuna chiamata LLM o API esterna a runtime.",
  "scripts": {
    "prepara": "node scripts/prepara.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:guardrails": "vitest run tests/guardrails.test.ts tests/lessico-ui.test.ts",
    "capture": "playwright test --config=playwright.config.ts",
    "deck": "node ../presentation/build-deck.ts",
    "deck:short": "node ../presentation/build-deck.ts --merge-7-8",
    "deck:compat": "tsc ../presentation/build-deck.ts --target es2022 --module nodenext --moduleResolution nodenext --skipLibCheck --outDir ../presentation/.compat && node ../presentation/.compat/build-deck.js",
    "agents:trace": "node scripts/agents-trace.mjs",
    "agents:sync": "node scripts/agents-sync.mjs",
    "evolution:proof": "node scripts/evolution-proof.mjs",
    "verify:roots": "node scripts/verify-roots.mjs",
    "docs:funzionali": "node scripts/docs-funzionali.mjs",
    "promuovi": "node scripts/promuovi.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
